[Unit]
Description=nodebench share server
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/nodebench-server
Environment=NODEBENCH_LISTEN=127.0.0.1:8080
Environment=NODEBENCH_BASE=https://bench.instantnode.eu
Environment=NODEBENCH_DATA=/var/lib/nodebench
Environment=NODEBENCH_SCRIPT=/usr/local/share/nodebench/nodebench.sh
Environment=NODEBENCH_PROXY=1
# Environment=NODEBENCH_EXAMPLE=<result id>
# EnvironmentFile=-/etc/nodebench/env  (NODEBENCH_ADMIN_TOKEN=...)
DynamicUser=yes
StateDirectory=nodebench
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
